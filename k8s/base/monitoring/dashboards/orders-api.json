{
  "title": "orders-api", "uid": "orders-api", "schemaVersion": 39, "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests/s by service", "gridPos": {"x":0,"y":0,"w":12,"h":8},
     "targets": [{"expr": "sum by (service) (rate(http_requests_total{service=~\"orders-api-.*\"}[1m]))", "legendFormat": "{{service}}"}]},
    {"id": 2, "type": "timeseries", "title": "5xx error ratio", "gridPos": {"x":12,"y":0,"w":12,"h":8},
     "targets": [{"expr": "sum by (service) (rate(http_requests_total{service=~\"orders-api-.*\",status=~\"5..\"}[1m])) / sum by (service) (rate(http_requests_total{service=~\"orders-api-.*\"}[1m]))", "legendFormat": "{{service}}"}]},
    {"id": 3, "type": "timeseries", "title": "p95 latency", "gridPos": {"x":0,"y":8,"w":12,"h":8},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket{service=~\"orders-api-.*\"}[2m])))", "legendFormat": "{{service}}"}]},
    {"id": 4, "type": "logs", "title": "Application logs (Loki)", "gridPos": {"x":12,"y":8,"w":12,"h":8},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"expr": "{app=\"orders-api\"} | json", "refId": "A"}]}
  ]
}
